# ── Aptly environment ────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

APTLY_ENV=development
APTLY_LOG_LEVEL=INFO

# ── Gemini ───────────────────────────────────────────────────────────────────
# MUST be a billing-enabled (paid) key.
# Google's free tier states "data used for training" — CVs are personal data,
# so the app refuses to start on a free-tier key when APTLY_REQUIRE_PAID_LLM=true.
GEMINI_API_KEY=
APTLY_REQUIRE_PAID_LLM=true

# Model tiering (see plan). Override only if you know why.
GEMINI_MODEL_MAIN=gemini-3.7-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI), then swap
# the scheme to postgresql+asyncpg://
DATABASE_URL=

# ── Supabase (auth + storage) ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=aptly-cvs

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ── Cost guardrails (anonymous tier costs real money) ─────────────────────────
APTLY_DAILY_SPEND_CEILING_USD=5.00
APTLY_ANON_TAILORS_PER_DAY=3
APTLY_MAX_UPLOAD_MB=5

# ── Optional, later milestones ───────────────────────────────────────────────
# RESEND_API_KEY=            # M10 email nudges
# POSTHOG_KEY=               # M18 metrics
